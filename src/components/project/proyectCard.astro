---
// src/components/project/proyectCard.astro
const { titulo, descripcion, ver, categoria, index } = Astro.props;

const categoriaLabels = {
  sql: "SQL",
  plsql: "PL/SQL Scripts",
  nosql: "NoSQL",
  proyecto: "Proyecto",
};
---

<div
  class="project-card bg-white/5 backdrop-blur-md rounded-xl overflow-hidden border border-[#69c7c7]/30 hover:border-[#69c7c7] transition-all duration-300 hover:scale-[1.02] hover:-translate-y-1 hover:shadow-[0_12px_32px_rgba(13,235,216,0.15)] w-[350px] max-w-full"
  data-index={index}
  data-categoria={categoria}
>
  <div class="p-6">
    <span class="inline-block mb-3 text-xs font-bold uppercase tracking-wide text-[#69c7c7] bg-[#69c7c7]/10 border border-[#69c7c7]/30 rounded-full px-3 py-1">
      {categoriaLabels[categoria] ?? categoria}
    </span>

    <h3 class="text-xl font-bold text-white mb-3">{titulo}</h3>

    <p class="text-gray-300 text-sm mb-4 min-h-[60px]">
      {descripcion}
    </p>
    
    {
      ver && (
        <a 
          href={ver}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block w-full text-center bg-[#69c7c7] text-[#1d1250] font-bold py-2 px-4 rounded-lg hover:bg-[#46caca] transition-all duration-300 shadow-[0_2px_12px_rgba(120,54,207,0.35)] hover:shadow-[0_4px_18px_rgba(120,54,207,0.5)] hover:-translate-y-0.5"
        >
          Ver evidencia
        </a>
      )
    }
  </div>
</div>